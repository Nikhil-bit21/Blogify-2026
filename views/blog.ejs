<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title>BlogPage</title>
    <link rel="stylesheet" href="/styles/blog.css">
</head>
<body>
    <%- include('./partials/nav.ejs') %>
    <div class="container mt-4 blog-author-row">
        <img src="<%= blog.createdBy.profileImageUrl %>" class="blog-author-avatar" alt="Author profile image">
        <div class="blog-author-text">
            <small class="text-muted">Author</small>
            <strong><%= blog.createdBy.fullName %></strong>
        </div>
    </div>
    <div class="container mt-4 blog-main-card">
        <h1><%= blog.title%></h1>
        <img src="<%= blog.coverImageUrl %>" width="600px" class="blog-cover">
        <div class="blog-body"><%= blog.body %></div>
    </div>

    <div class="container mt-3 comments-section">
        <h1>Comments (<%= comment.length %>)</h1>
        <% if (locals.user) { %>
            <form action="/blog/comment/<%= blog._id %>" method="post" class="comment-form">
                <div class="mb-3">
                    <input type="text" class="form-control" id="content" name="content" placeholder="Enter Your Thoughts!">
                    <button class="btn btn-sm btn-primary mt-2" type="submit">Add</button>
                </div>
            </form>
        <% } %>
        <div class="mt-3">
            <% comment.forEach(com => { %>
                <div class="comment-card">
                    <p class="comment-content"><%= com.content %></p>
                    <div class="comment-footer">
                        <img src="<%= com.createdBy.profileImageUrl %>" class="comment-avatar" alt="Comment author profile image">
                        <span class="comment-author"><%= com.createdBy.fullName %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include('./partials/scripts.ejs') %>
</body>
</html>