<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title>BlogPage</title>
    <style>
        body {
            background: linear-gradient(180deg, #f3e8e8 0%, #e9edf5 35%, #f5f2f2 100%);
            color: #1f2937;
            min-height: 100vh;
        }

        .author-row {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-left: 18px;
            margin-bottom: 20px;
            padding: 10px 12px;
            width: fit-content;
            background: rgba(255, 248, 248, 0.9);
            border: 1px solid rgba(239, 68, 68, 0.18);
            border-radius: 999px;
            box-shadow: 0 8px 20px rgba(127, 29, 29, 0.06);
        }

        .author-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #dfeafc;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.12);
        }

        .author-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: #1f2937;
        }

        .comments-section {
            margin-left: 18px;
        }

        .comment-form {
            margin-left: 0;
            max-width: 700px;
        }

        .comment-form .form-control {
            background: rgba(255, 255, 255, 0.82);
            border: 1px solid #d8e4f4;
            border-radius: 12px;
            padding: 12px 14px;
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        .comment-card {
            background: linear-gradient(135deg, #fdf2f2 0%, #eaf1ff 100%);
            border: 1px solid #d9e4f7;
            border-left: 5px solid #ef4444;
            border-radius: 16px;
            padding: 18px 18px 14px;
            margin: 14px 0;
            max-width: 700px;
            box-shadow: 0 10px 24px rgba(239, 68, 68, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .comment-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(91, 82, 214, 0.12);
        }

        .comment-content {
            margin: 0 0 12px 0;
            line-height: 1.7;
            color: #1f2937;
            font-size: 1rem;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.58);
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .comment-footer {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            margin-top: 8px;
        }

        .comment-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
        }

        .comment-author {
            font-size: 0.92rem;
            font-weight: 700;
            color: #334155;
        }

        .blog-main-card {
            background: linear-gradient(180deg, rgba(255, 249, 249, 0.9) 0%, rgba(233, 239, 255, 0.9) 100%);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 20px;
            padding: 22px 20px;
            box-shadow: 0 12px 30px rgba(127, 29, 29, 0.05);
            backdrop-filter: blur(8px);
        }

        .blog-main-card h1 {
            margin-bottom: 18px;
        }

        .blog-body {
            margin-top: 18px;
            font-size: 1.05rem;
            line-height: 1.9;
            color: #1f2937;
            white-space: pre-wrap;
            word-break: break-word;
            overflow-wrap: break-word;
            background: rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 14px;
            padding: 18px 20px;
        }

        .blog-cover {
            border-radius: 16px;
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
            max-width: 100%;
            height: auto;
        }

        .container h1 {
            color: #111827;
        }
    </style>
</head>
<body>
    <%- include('./partials/nav.ejs') %>
    <div class="container mt-4 author-row">
        <img src="<%= blog.createdBy.profileImageUrl %>" class="author-avatar" alt="Author profile image">
        <div class="author-text">
            <small class="text-muted">Author</small>
            <strong><%= blog.createdBy.fullName %></strong>
        </div>
    </div>
    <div class="container mt-4 blog-main-card">
        <h1><%= blog.title%></h1>
        <img src="<%= blog.coverImageUrl %>" width="600px" class="blog-cover">
        <div class="blog-body"><%= blog.body %></div>
    </div>

    <div class="container mt-3 comments-section">
        <h1>Comments (<%= comment.length %>)</h1>
        <% if (locals.user) { %>
            <form action="/blog/comment/<%= blog._id %>" method="post" class="comment-form">
                <div class="mb-3">
                    <input type="text" class="form-control" id="content" name="content" placeholder="Enter Your Thoughts!">
                    <button class="btn btn-sm btn-primary mt-2" type="submit">Add</button>
                </div>
            </form>
        <% } %>
        <div class="mt-3">
            <% comment.forEach(com => { %>
                <div class="comment-card">
                    <p class="comment-content"><%= com.content %></p>
                    <div class="comment-footer">
                        <img src="<%= com.createdBy.profileImageUrl %>" class="comment-avatar" alt="Comment author profile image">
                        <span class="comment-author"><%= com.createdBy.fullName %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include('./partials/scripts.ejs') %>
</body>
</html>